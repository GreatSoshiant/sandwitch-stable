{
  "name": "tidewater-pay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contracts": "tsx scripts/test-contracts.ts",
    "deploy:demo": "tsx --env-file=.env.local scripts/deploy-demo.ts",
    "verify:permissions": "tsx --env-file=.env.local scripts/verify-permissions.ts",
    "verify:testnet": "tsx --env-file=.env.local scripts/verify-testnet.ts",
    "test:testnet": "playwright test --config playwright.testnet.config.ts",
    "vercel:env": "node scripts/sync-vercel-env.mjs"
  },
  "dependencies": {
    "@zerodev/passkey-validator": "5.6.0",
    "@zerodev/permissions": "5.6.5",
    "@zerodev/sdk": "5.5.12",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.58.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v3-periphery": "1.4.4",
    "@zerodev/ecdsa-validator": "5.4.9",
    "solc": "0.8.38",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
