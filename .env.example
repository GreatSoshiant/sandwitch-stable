# Public browser configuration. Never put a private key in NEXT_PUBLIC_*.
NEXT_PUBLIC_ZERODEV_RPC_URL=
NEXT_PUBLIC_ZERODEV_PASSKEY_SERVER_URL=
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Fill these with deploy:demo output, or your existing verified contracts.
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_EURC_ADDRESS=
NEXT_PUBLIC_SWAP_ROUTER_ADDRESS=
NEXT_PUBLIC_QUOTER_ADDRESS=
NEXT_PUBLIC_POOL_ADDRESS=
NEXT_PUBLIC_SUPPLIER_ADDRESS=
NEXT_PUBLIC_PAYMENT_GATEWAY_ADDRESS=
# First block of the configured invoice gateway; default matches the team demo.
NEXT_PUBLIC_PAYMENT_HISTORY_START_BLOCK=330494907
NEXT_PUBLIC_BACKUP_VALIDATOR_FACTORY_ADDRESS=
# Enable only for the DemoToken dollar token deployed by this repository.
NEXT_PUBLIC_ENABLE_TEST_FAUCET=false
# Your enterprise contact form. A local demo contact dialog is shown if empty.
NEXT_PUBLIC_ENTERPRISE_CONTACT_URL=
# Server-side only; optional CoinGecko Demo API key.
COINGECKO_DEMO_API_KEY=
# Deployment script only: a funded Arbitrum Sepolia TEST account.
# DEPLOYER_PRIVATE_KEY=
# Optional: existing six-decimal test EURC; must be funded in deployer account.
# EXISTING_EURC_ADDRESS=
# Optional deployment controls (test ETH only). Successful steps resume from a public journal.
# DEPLOYMENT_MAX_COST_ETH=0.02
# DEPLOYMENT_JOURNAL=deployments/arbitrum-sepolia.json
